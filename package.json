{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "og": "tsx scripts/generate-og.tsx",
    "dev": "NODE_OPTIONS='--max-old-space-size=6144' rm -rf .next && next dev",
    "build": "pnpm og && rm -rf .next && NODE_ENV=production next build",
    "build:cf": "pnpm og && opennextjs-cloudflare build",
    "preview": "pnpm build:cf && opennextjs-cloudflare preview",
    "deploy": "pnpm build:cf && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "clean-install": "rm -rf node_modules pnpm-lock.yaml yarn.lock bun.lockb package-lock.json && pnpm install",
    "clean-install-pmy": "rm -rf node_modules pnpm-lock.yaml yarn.lock bun.lockb package-lock.json && yarn",
    "clean-install-rb": "rm -rf node_modules pnpm-lock.yaml yarn.lock bun.lockb package-lock.json && bun install",
    "clean-build": "pnpm run clean-install && pnpm build",
    "clean-build-pmy": "yarn run clean-install-pmy && yarn run build",
    "clean-build-rb": "bun run clean-install-rb && bun run build",
    "start": "NODE_ENV=production next start -p 8080",
    "format": "prettier --write .",
    "lint": "eslint .",
    "analyze": "ANALYZE=true next build",
    "preview:email": "tsx scripts/preview-emails.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@marsidev/react-turnstile": "^1.6.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.84.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.125.0"
  }
}
