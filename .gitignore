# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
CHANGELOG.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
# next-env.d.ts

certificates
.playwright-mcp
.code-review-graph

# cloudflare (OpenNext adapter — build output and local wrangler state)
/.open-next/
/.wrangler/

# graphify (knowledge graph — regenerated locally, contains absolute paths)
/graphify-out/
.graphify/

# build-time social cards and touch icon (scripts/generate-og.tsx, run by `pnpm og`,
# which both `build` and `build:cf` run first — regenerated, never hand-edited)
/public/og/
/public/apple-icon.png

# local email template previews (scripts/preview-emails.ts) — regenerated, never committed
/.email-preview/

# local audit artifacts (chrome devtools screenshots, lighthouse reports)
/.audit/
