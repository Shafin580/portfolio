# Two files, deliberately split:
#
#   .env        TRACKED in git — public build-time values only (NEXT_PUBLIC_*)
#   .env.local  git-ignored via `.env*.local` — every server-only secret
#
# Never put RESEND_API_KEY or TURNSTILE_SECRET_KEY in .env; that file is committed.
#
# Nothing here is required for the site to build or render — the contact form detects
# missing configuration (the API answers 503 not_configured) and falls back to a
# pre-filled mailto: link instead of failing. Fill these in when you are ready to accept
# form submissions.

# --- Canonical host -------------------------------------------------------------
# Overrides the fallback in lib/site.ts so preview deploys emit their own host.
NEXT_PUBLIC_SITE_URL=https://shadev-tech.com

# --- Spam protection (Cloudflare Turnstile) -------------------------------------
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# The SITE key is public by design — it ships to the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# SERVER-ONLY. Must never be prefixed NEXT_PUBLIC_.
TURNSTILE_SECRET_KEY=

# --- Email delivery (Resend) ----------------------------------------------------
# 1. Create a key at https://resend.com/api-keys
# 2. Verify the sending domain (DNS records in the Resend dashboard)
# SERVER-ONLY. Must never be prefixed NEXT_PUBLIC_.
RESEND_API_KEY=
# Where contact enquiries land.
CONTACT_TO_EMAIL=shafinwork580@gmail.com
# Must be on a domain verified in Resend.
CONTACT_FROM_EMAIL=contact@shadev-tech.com
