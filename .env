# TRACKED IN GIT — public build-time values only.
#
# Anything server-only (RESEND_API_KEY, TURNSTILE_SECRET_KEY, CONTACT_*) goes in
# .env.local, which .gitignore excludes via `.env*.local`. See .env.example.

NEXT_PUBLIC_SITE_URL=https://shadev-tech.com

# Cloudflare Turnstile SITE key. Public by design — Next inlines it into the client
# bundle, and the widget cannot work without it reaching the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
